---
import ProjectCard from './ProjectCard.astro';
import { projects } from '../data/projects';

const ordered = [...projects.filter((p) => p.featured), ...projects.filter((p) => !p.featured)];
---

<section id="projetos" class="section">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Projetos</span>
      <h2 class="section-title">Seis produtos, um problema de dados cada</h2>
      <p class="section-lede">
        Cada projeto nasceu de um problema real de dados, do provisionamento de acesso à
        auditoria de bases financeiras. Os três primeiros já têm impacto validado em produção —
        clique em qualquer um para ver o problema, a solução, a arquitetura e o resultado completos.
      </p>
    </div>

    <div class="modules-list" data-reveal-group>
      {ordered.map((project, i) => (
        <ProjectCard project={project} index={i} />
      ))}
    </div>
  </div>
</section>

<style>
  .modules-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
</style>
