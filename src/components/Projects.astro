---
import ProjectCard from './ProjectCard.astro';
import { projects } from '../data/projects';

const ordered = [...projects.filter((p) => p.featured), ...projects.filter((p) => !p.featured)];
---

<section id="projetos" class="section">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Projetos</span>
      <h2 class="section-title">Seis produtos, um problema de dados cada</h2>
      <p class="section-lede">
        Os três primeiros têm métrica de impacto medida em produção. Clique em um projeto para
        abrir problema, solução, arquitetura e resultado.
      </p>
    </div>

    <div class="modules-list" data-reveal-group>
      {ordered.map((project, i) => (
        <ProjectCard project={project} index={i} />
      ))}
    </div>
  </div>
</section>

<style>
  .modules-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
</style>
