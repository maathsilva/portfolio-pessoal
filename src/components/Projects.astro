---
import ProjectCard from './ProjectCard.astro';
import { projects } from '../data/projects';

const ordered = [...projects.filter((p) => p.featured), ...projects.filter((p) => !p.featured)];
---

<section id="projetos" class="section">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Projetos</span>
      <h2 class="section-title">Seis produtos, um problema real cada</h2>
      <p class="section-lede">
        Ferramentas que criei para problemas reais de dados — auditoria de ETL, provisionamento de
        acessos, validação de bases financeiras e automação de relatórios — e uma aplicação completa
        entregue para um cliente. Todos estão em produção; clique em qualquer um para ver o problema,
        a solução, a arquitetura e o resultado.
      </p>
    </div>

    <div class="modules-list" data-reveal-group>
      {ordered.map((project, i) => (
        <ProjectCard project={project} index={i} />
      ))}
    </div>
  </div>
</section>

<style>
  .modules-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
</style>
