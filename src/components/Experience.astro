---
import { experience } from '../data/experience';
---

<section id="experiencia" class="section experience-section">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Trajetória</span>
      <h2 class="section-title">Experiência Profissional</h2>
    </div>

    <ol class="timeline">
      {experience.map((job) => (
        <li class="timeline-item">
          <div class="timeline-marker">
            {job.current && <span class="pulse" aria-hidden="true"></span>}
          </div>
          <div class="timeline-content card">
            <div class="timeline-head">
              <h3>{job.role} <span class="mono timeline-company">— {job.company}</span></h3>
              <span class="mono timeline-period">{job.period}</span>
            </div>
            <ul>
              {job.bullets.map((bullet) => <li>{bullet}</li>)}
            </ul>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .timeline {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .timeline::before {
    content: '';
    position: absolute;
    left: 5px;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 1px;
    background: var(--border);
  }
  .timeline-item {
    display: grid;
    grid-template-columns: 12px 1fr;
    gap: 1.5rem;
  }
  .timeline-marker {
    position: relative;
    top: 0.4rem;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--border-strong);
  }
  .timeline-item:first-child .timeline-marker {
    background: var(--accent);
  }
  .pulse {
    position: absolute;
    inset: -5px;
    border-radius: 50%;
    border: 1px solid var(--accent);
    animation: pulse 2s var(--ease) infinite;
  }
  @keyframes pulse {
    0% { transform: scale(0.8); opacity: 0.8; }
    100% { transform: scale(1.8); opacity: 0; }
  }
  .timeline-content {
    padding: 1.75rem 2rem;
  }
  .timeline-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .timeline-head h3 {
    font-size: 1.15rem;
    font-family: var(--font-sans);
  }
  .timeline-company {
    color: var(--accent);
    font-weight: 500;
    font-size: 0.9rem;
  }
  .timeline-period {
    font-size: 0.8rem;
    color: var(--muted-2);
  }
  .timeline-content ul {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .timeline-content li {
    font-size: 0.92rem;
    color: var(--muted);
    padding-left: 1.1rem;
    position: relative;
  }
  .timeline-content li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent-dim);
  }
</style>
