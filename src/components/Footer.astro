---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-bottom">
    <p>© {year} Matheus Silva. Todos os direitos reservados. · <a href="/privacidade">Privacidade</a></p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding: 2.5rem 0;
  }
  .footer-bottom a {
    text-decoration: underline;
  }
  .footer-bottom a:hover {
    color: var(--accent);
  }
  .footer-bottom {
    text-align: center;
    font-size: 0.85rem;
    color: var(--muted-2);
  }
</style>
