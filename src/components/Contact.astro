---
import Icon from './Icon.astro';
import { site } from '../data/site';

const waLink = `https://wa.me/${site.phone.replace('+', '')}?text=${encodeURIComponent(site.whatsappMessage)}`;
---

<section id="contato" class="section contact-section">
  <div class="container">
    <span class="eyebrow" style="justify-content:center">Contato</span>
    <h2 class="contact-title">Transformar dado <span class="accent">em decisão.</span></h2>
    <p class="contact-lede">
      Aberto a oportunidades em dados, IA e automação. Resposta em até 1 dia útil.
    </p>

    <div class="contact-links">
      <a href={`mailto:${site.email}`} class="btn btn-secondary" data-cta="email"><Icon name="mail" /> E-mail</a>
      <a href={site.linkedin} target="_blank" rel="noopener noreferrer" class="btn btn-secondary" data-cta="linkedin"><Icon name="linkedin" /> LinkedIn</a>
      <a href={site.github} target="_blank" rel="noopener noreferrer" class="btn btn-secondary" data-cta="github"><Icon name="github" /> GitHub</a>
      <a href={waLink} target="_blank" rel="noopener noreferrer" class="btn btn-secondary" data-cta="whatsapp"><Icon name="message-circle" /> WhatsApp</a>
    </div>
  </div>
</section>

<style>
  .contact-section {
    text-align: center;
    padding-bottom: 6rem;
  }
  .contact-title {
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    max-width: 16ch;
    margin: 0 auto;
  }
  .contact-lede {
    margin: 1.25rem auto 0;
    max-width: 46ch;
    font-size: 1.05rem;
  }
  .contact-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-top: 2.75rem;
  }
</style>
