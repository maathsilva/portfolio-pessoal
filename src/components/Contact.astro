---
import Icon from './Icon.astro';
import { site } from '../data/site';

const waLink = `https://wa.me/${site.phone.replace('+', '')}?text=${encodeURIComponent(site.whatsappMessage)}`;
---

<section id="contato" class="section contact-section">
  <div class="container">
    <div class="section-head centered">
      <span class="eyebrow" style="justify-content:center">Contato</span>
      <h2 class="section-title">Vamos conversar</h2>
      <p class="section-lede">
        Aberto a oportunidades em dados, ETL e automação. Resposta em até 1 dia útil.
      </p>
    </div>

    <div class="contact-links">
      <a href={`mailto:${site.email}`} class="btn btn-secondary"><Icon name="mail" /> E-mail</a>
      <a href={site.linkedin} target="_blank" rel="noopener noreferrer" class="btn btn-secondary"><Icon name="linkedin" /> LinkedIn</a>
      <a href={site.github} target="_blank" rel="noopener noreferrer" class="btn btn-secondary"><Icon name="github" /> GitHub</a>
      <a href={waLink} target="_blank" rel="noopener noreferrer" class="btn btn-primary"><Icon name="message-circle" /> WhatsApp</a>
    </div>
  </div>
</section>

<style>
  .contact-section {
    text-align: center;
    padding-bottom: 6rem;
  }
  .section-head.centered {
    max-width: 560px;
    margin: 0 auto;
  }
  .contact-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-top: 2.5rem;
  }
</style>
