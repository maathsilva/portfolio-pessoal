---
import { education, certifications } from '../data/experience';
import Icon from './Icon.astro';
---

<section id="formacao" class="section">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Formação</span>
      <h2 class="section-title">Formação Acadêmica & Certificações</h2>
    </div>

    <div class="education-grid">
      {education.map((item) => (
        <div class="edu-card card card-hover">
          <span class="mono edu-period">{item.period}</span>
          <h3>{item.title}</h3>
          <p class="edu-institution">{item.institution}</p>
          <p class="edu-desc">{item.description}</p>
        </div>
      ))}
    </div>

    <h3 class="subhead"><Icon name="check-square" size={18} /> Certificações</h3>
    <ul class="cert-grid">
      {certifications.map((cert) => (
        <li class="cert-item card">
          <div>
            <p class="cert-title">{cert.title}</p>
            <p class="mono cert-meta">{cert.institution} · {cert.year}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .education-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-bottom: 3.5rem;
  }
  .edu-card {
    padding: 1.75rem;
  }
  .edu-period {
    font-size: 0.78rem;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .edu-card h3 {
    font-size: 1.15rem;
    font-family: var(--font-sans);
    margin: 0.6rem 0 0.35rem;
  }
  .edu-institution {
    color: var(--text);
    font-size: 0.9rem;
    font-weight: 500;
    margin-bottom: 0.75rem;
  }
  .edu-desc {
    font-size: 0.9rem;
    margin: 0;
  }

  .subhead {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.15rem;
    font-family: var(--font-sans);
    font-weight: 600;
    color: var(--accent);
    margin-bottom: 1.5rem;
  }
  .cert-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .cert-item {
    padding: 1.1rem 1.35rem;
  }
  @media (max-width: 760px) {
    .cert-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 480px) {
    .cert-grid {
      grid-template-columns: 1fr;
    }
  }
  .cert-title {
    color: var(--text);
    font-size: 0.92rem;
    font-weight: 500;
  }
  .cert-meta {
    color: var(--muted-2);
    font-size: 0.75rem;
    margin-top: 0.25rem;
  }
</style>
