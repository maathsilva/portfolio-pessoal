---
// Screenshot presented as a browser window: title bar with the three dots,
// a shimmer while the image loads (see src/scripts/media.ts) and a zoom hint.
interface Props {
  /** Fixed aspect ratio for the viewport (e.g. '2 / 1'); omit to keep the image's own. */
  ratio?: string;
  class?: string;
}

const { ratio, class: className = '' } = Astro.props;
---

<div class={`browser ${className}`}>
  <div class="browser-bar" aria-hidden="true">
    <span></span><span></span><span></span>
  </div>
  <div class="browser-view" data-shimmer style={ratio ? `aspect-ratio: ${ratio}` : undefined}>
    <slot />
  </div>
</div>

<style>
  .browser {
    border-radius: 0.8rem;
    overflow: hidden;
    background: var(--bg-elevated);
    border: 1px solid var(--border-strong);
    box-shadow:
      inset 0 1px 0 hsl(210 60% 95% / 0.05),
      0 24px 60px -30px rgb(0 0 0 / 0.9);
  }
  .browser-bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    height: 1.9rem;
    padding: 0 0.8rem;
    background: hsl(222 28% 9%);
    border-bottom: 1px solid var(--border);
  }
  .browser-bar span {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
  }
  .browser-bar span:nth-child(1) {
    background: hsl(0 72% 62% / 0.85);
  }
  .browser-bar span:nth-child(2) {
    background: hsl(40 85% 58% / 0.85);
  }
  .browser-bar span:nth-child(3) {
    background: hsl(135 45% 50% / 0.85);
  }

  .browser-view {
    position: relative;
    overflow: hidden;
    background:
      linear-gradient(100deg, transparent 30%, hsl(217 45% 65% / 0.08) 50%, transparent 70%) 0 0 / 220% 100%,
      var(--card);
    animation: shimmer 1.5s linear infinite;
  }
  .browser-view:global(.is-loaded) {
    animation: none;
  }
  .browser-view :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition: opacity 0.5s var(--ease), transform 0.6s var(--ease);
  }
  .browser-view :global(img.is-loading) {
    opacity: 0;
  }

  @keyframes shimmer {
    from {
      background-position: 120% 0, 0 0;
    }
    to {
      background-position: -120% 0, 0 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .browser-view {
      animation: none;
    }
  }
</style>
