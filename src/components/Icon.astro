interface Props {
  name: keyof typeof ICONS | string;
  size?: number;
  class?: string;
  "aria-hidden"?: boolean;
}

const { name, size = 20, class: className = "" } = Astro.props;
const path = ICONS[name] ?? "";
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
  set:html={path}
/>
