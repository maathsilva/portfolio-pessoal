---
import Icon from './Icon.astro';
import { site } from '../data/site';
---

<section id="home" class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="hero-tag mono">
        <span class="dot" aria-hidden="true"></span>
        <span class="role-type" data-typewriter data-words={JSON.stringify(site.roles)}>{site.role}</span><span class="hero-cursor" aria-hidden="true">_</span>
      </p>
      <h1>
        Transformo processos manuais em <span class="accent">pipelines confiáveis</span>.
      </h1>
      <p class="hero-lede">
        Construo automações, ETLs e dashboards que tiram o operacional do caminho e colocam
        dado auditável na mão de quem decide — de Python e SQL a Power BI e Databricks.
      </p>

      <div class="hero-buttons">
        <a href="#projetos" class="btn btn-primary">
          <Icon name="briefcase" /> Ver Projetos
        </a>
        <a href={site.resumeUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
          <Icon name="download" /> Baixar Currículo
        </a>
      </div>

      <dl class="hero-stats">
        {site.heroStats.map((stat) => (
          <div class="stat">
            <dt class="mono">{stat.value}</dt>
            <dd>{stat.label}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 5.5rem 0 4rem;
    min-height: 80vh;
    display: flex;
    align-items: center;
  }
  .hero-grid {
    display: flex;
    justify-content: center;
  }
  .hero-copy {
    max-width: 760px;
    text-align: center;
  }
  .hero-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.9rem;
    color: var(--accent);
    background: hsl(32 60% 58% / 0.1);
    border: 1px solid hsl(32 60% 58% / 0.25);
    padding: 0.4rem 0.9rem;
    border-radius: 99px;
    margin-bottom: 1.5rem;
  }
  .hero-tag .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
  }
  .role-type {
    display: inline-block;
    white-space: nowrap;
    vertical-align: bottom;
    min-width: 1ch;
  }
  .hero-cursor {
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% { opacity: 0; }
  }
  h1 {
    font-size: clamp(2.2rem, 4.4vw, 3.4rem);
    letter-spacing: -0.02em;
    margin-bottom: 1.25rem;
  }
  .hero-lede {
    font-size: 1.1rem;
    max-width: 52ch;
    margin: 0 auto 2.25rem auto;
  }
  .hero-buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 3rem;
  }
  .hero-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    border-top: 1px solid var(--border);
    padding-top: 1.75rem;
    max-width: 620px;
    margin: 0 auto;
  }
  .stat dt {
    font-size: 1.3rem;
    color: var(--accent);
    font-weight: 500;
  }
  .stat dd {
    margin-top: 0.35rem;
    font-size: 0.82rem;
    color: var(--muted-2);
    line-height: 1.4;
  }

  @media (max-width: 480px) {
    .hero-stats {
      grid-template-columns: 1fr;
      gap: 1rem;
      text-align: left;
    }
  }
</style>
