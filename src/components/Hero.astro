---
import Icon from './Icon.astro';
import { site } from '../data/site';
---

<section id="home" class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="hero-tag mono">
        <span class="hero-tag-prefix">Eu sou</span>
        <span class="role-type" data-typewriter data-words={JSON.stringify(site.roles)}>{site.roles[0]}</span><span class="hero-cursor" aria-hidden="true">_</span>
      </p>

      <h1 class="hero-headline">
        <span class="hero-headline-line hero-headline-outline">Transformando dados</span>
        <span class="hero-headline-line accent">em inteligência.</span>
      </h1>

      <p class="hero-sub">
        Construo pipelines, modelos e dashboards que tiram o operacional do caminho e colocam
        dado auditável na mão de quem decide — de Python e SQL a Machine Learning e Databricks.
      </p>

      <div class="hero-buttons">
        <a href="#projetos" class="btn btn-primary">
          <Icon name="briefcase" /> Ver Projetos
        </a>
        <a href={site.resumeUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary" data-cta="curriculo">
          <Icon name="download" /> Baixar Currículo
        </a>
      </div>

      <dl class="hero-stats">
        {site.heroStats.map((stat) => (
          <div class="stat">
            <dt class="mono">{stat.value}</dt>
            <dd>{stat.label}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 6.5rem 0 3rem;
    margin-top: -4.75rem;
    overflow: hidden;
  }
  .hero-grid {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: center;
    width: 100%;
    margin: auto 0;
  }
  .hero-copy {
    max-width: 780px;
    text-align: center;
  }
  .hero-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.95rem;
    background: hsl(222 30% 8% / 0.7);
    backdrop-filter: blur(6px);
    border: 1px solid var(--border);
    padding: 0.55rem 1.1rem;
    border-radius: 99px;
    margin-bottom: 1.5rem;
  }
  .hero-tag-prefix {
    color: var(--muted);
    font-weight: 400;
  }
  .role-type {
    display: inline-block;
    white-space: nowrap;
    vertical-align: bottom;
    min-width: 1ch;
    color: var(--accent);
    font-weight: 600;
  }
  .hero-cursor {
    color: var(--accent);
    font-weight: 600;
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% { opacity: 0; }
  }
  .hero-headline {
    display: flex;
    flex-direction: column;
    gap: 0.15em;
    font-size: clamp(1.9rem, 4.6vw, 3.4rem);
    line-height: 1.08;
    letter-spacing: -0.015em;
    margin-bottom: 1.25rem;
  }
  /* The first line is hollow — the data network reads through the letterforms,
     like looking into the system — while the second line grounds it in solid
     accent blue. */
  .hero-headline-outline {
    color: var(--text);
  }
  @supports (-webkit-text-stroke: 1px black) or (text-stroke: 1px black) {
    .hero-headline-outline {
      color: transparent;
      -webkit-text-stroke: 1px var(--text);
      text-stroke: 1px var(--text);
    }
  }
  .hero-headline .accent {
    text-shadow: 0 0 56px rgb(var(--accent-rgb) / 0.45);
  }
  .hero-sub {
    font-size: 1rem;
    max-width: 56ch;
    margin: 0 auto 1.75rem auto;
  }
  .hero-buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 2.25rem;
  }
  .hero-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    border-top: 1px solid var(--border);
    padding-top: 1.25rem;
    max-width: 620px;
    margin: 0 auto;
  }
  .stat dt {
    font-size: 1.3rem;
    color: var(--accent);
    font-weight: 500;
  }
  .stat dd {
    margin-top: 0.35rem;
    font-size: 0.82rem;
    color: var(--muted-2);
    line-height: 1.4;
  }

  @media (max-width: 480px) {
    .hero-stats {
      grid-template-columns: 1fr;
      gap: 1rem;
      text-align: left;
    }
  }
</style>
