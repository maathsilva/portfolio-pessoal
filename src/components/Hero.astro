---
import Icon from './Icon.astro';
import { site } from '../data/site';

const [firstName, ...restName] = site.name.toUpperCase().split(' ');
---

<section id="home" class="hero">
  <canvas data-hero-network class="hero-network" aria-hidden="true"></canvas>
  <div class="hero-fade" aria-hidden="true"></div>

  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="hero-tag mono">
        <span class="hero-tag-prefix">Eu sou</span>
        <span class="role-type" data-typewriter data-words={JSON.stringify(site.roles)}>{site.roles[0]}</span><span class="hero-cursor" aria-hidden="true">_</span>
      </p>

      <h1 class="hero-name">
        <span class="hero-name-line">{firstName}</span>
        <span class="hero-name-line accent">{restName.join(' ')}</span>
      </h1>

      <p class="hero-lede">Transformando dados em inteligência.</p>
      <p class="hero-sub">
        Construo pipelines, modelos e dashboards que tiram o operacional do caminho e colocam
        dado auditável na mão de quem decide — de Python e SQL a Machine Learning e Databricks.
      </p>

      <div class="hero-buttons">
        <a href="#projetos" class="btn btn-primary">
          <Icon name="briefcase" /> Ver Projetos
        </a>
        <a href={site.resumeUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary" data-cta="curriculo">
          <Icon name="download" /> Baixar Currículo
        </a>
      </div>

      <dl class="hero-stats">
        {site.heroStats.map((stat) => (
          <div class="stat">
            <dt class="mono">{stat.value}</dt>
            <dd>{stat.label}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>

  <a href="#sobre" class="hero-scroll mono" aria-label="Rolar para ver mais">
    <span>Role para saber mais</span>
    <span class="hero-scroll-line" aria-hidden="true"></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 6.5rem 0 3rem;
    margin-top: -4.75rem;
    overflow: hidden;
  }
  .hero-network {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.85;
  }
  .hero-fade {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, transparent 0%, transparent 40%, var(--bg) 92%),
      linear-gradient(to bottom, transparent 65%, var(--bg) 100%);
    pointer-events: none;
  }
  .hero-grid {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: center;
    width: 100%;
    margin: auto 0;
  }
  .hero-copy {
    max-width: 780px;
    text-align: center;
  }
  .hero-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.95rem;
    background: hsl(222 30% 8% / 0.7);
    backdrop-filter: blur(6px);
    border: 1px solid var(--border);
    padding: 0.55rem 1.1rem;
    border-radius: 99px;
    margin-bottom: 1.5rem;
  }
  .hero-tag-prefix {
    color: var(--muted);
    font-weight: 400;
  }
  .role-type {
    display: inline-block;
    white-space: nowrap;
    vertical-align: bottom;
    min-width: 1ch;
    color: var(--accent);
    font-weight: 600;
  }
  .hero-cursor {
    color: var(--accent);
    font-weight: 600;
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% { opacity: 0; }
  }
  .hero-name {
    display: flex;
    flex-direction: column;
    gap: 0.1em;
    font-size: clamp(2.75rem, 7.5vw, 5.4rem);
    line-height: 0.98;
    letter-spacing: -0.03em;
    margin-bottom: 1.1rem;
  }
  .hero-lede {
    font-size: clamp(1.05rem, 1.8vw, 1.3rem);
    color: var(--text);
    font-family: var(--font-display);
    font-weight: 600;
    margin-bottom: 0.85rem;
  }
  .hero-sub {
    font-size: 1rem;
    max-width: 56ch;
    margin: 0 auto 1.75rem auto;
  }
  .hero-buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 2.25rem;
  }
  .hero-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    border-top: 1px solid var(--border);
    padding-top: 1.25rem;
    max-width: 620px;
    margin: 0 auto;
  }
  .stat dt {
    font-size: 1.3rem;
    color: var(--accent);
    font-weight: 500;
  }
  .stat dd {
    margin-top: 0.35rem;
    font-size: 0.82rem;
    color: var(--muted-2);
    line-height: 1.4;
  }

  .hero-scroll {
    position: relative;
    z-index: 1;
    margin-top: 2.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted-2);
    transition: color var(--dur) var(--ease);
    flex-shrink: 0;
  }
  .hero-scroll:hover {
    color: var(--accent);
  }
  .hero-scroll-line {
    width: 1px;
    height: 2.5rem;
    background: linear-gradient(to bottom, var(--accent), transparent);
    animation: scroll-cue 1.8s var(--ease) infinite;
  }
  @keyframes scroll-cue {
    0%, 100% { opacity: 0.3; transform: scaleY(0.6); transform-origin: top; }
    50% { opacity: 1; transform: scaleY(1); transform-origin: top; }
  }

  @media (max-width: 480px) {
    .hero-stats {
      grid-template-columns: 1fr;
      gap: 1rem;
      text-align: left;
    }
    .hero-scroll {
      display: none;
    }
  }
</style>
