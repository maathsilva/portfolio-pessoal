---
import Icon from './Icon.astro';
import { skillGroups } from '../data/skills';

const find = (title: string) => skillGroups.find((g) => g.title === title)?.items ?? [];

const tracks = [
  {
    key: 'analyst',
    icon: 'bar-chart',
    title: 'Data Analyst',
    summary: 'Transformo dado validado em indicador de negócio — dashboards e relatórios que sustentam decisão.',
    items: [...find('BI & Visualização'), 'SQL'],
  },
  {
    key: 'scientist',
    icon: 'code',
    title: 'Data Scientist',
    summary: 'Análise estatística e modelagem sobre dado já limpo — de Pandas a machine learning aplicado.',
    items: [...find('Linguagens & Análise de Dados'), ...find('Cloud & Data Platforms')],
  },
  {
    key: 'engineer',
    icon: 'workflow',
    title: 'Data Engineer',
    summary: 'Governança, ETL/ELT e arquitetura — a camada que garante que o dado chegue íntegro e auditável.',
    items: [...find('Engenharia de Dados & ETL'), ...find('Bancos de Dados'), ...find('Automação & Governança')],
  },
];
---

<section id="especialidades" class="section specialties-section">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Especialidades</span>
      <h2 class="section-title">Três módulos, um mesmo sistema</h2>
      <p class="section-lede">
        Analytics, Science e Engineering não são papéis isolados — são camadas do mesmo pipeline,
        e no dia a dia costumo transitar pelas três.
      </p>
    </div>

    <div class="modules" data-reveal-group>
      <svg class="modules-link" viewBox="0 0 100 12" preserveAspectRatio="none" aria-hidden="true">
        <line x1="16.5" y1="0" x2="50" y2="12" />
        <line x1="83.5" y1="0" x2="50" y2="12" />
      </svg>
      {tracks.map((track) => (
        <article class="module card card-hover">
          <div class="module-head">
            <span class="module-icon"><Icon name={track.icon} size={22} /></span>
            <h3>{track.title}</h3>
          </div>
          <p class="module-summary">{track.summary}</p>
          <ul class="module-items">
            {track.items.map((item) => <li>{item}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .modules {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.75rem;
  }
  .modules-link {
    position: absolute;
    top: -1.75rem;
    left: 0;
    width: 100%;
    height: 1.75rem;
    overflow: visible;
  }
  .modules-link line {
    stroke: var(--border-strong);
    stroke-width: 0.3;
    vector-effect: non-scaling-stroke;
  }
  .module {
    padding: 1.85rem;
    display: flex;
    flex-direction: column;
  }
  .module-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.85rem;
  }
  .module-icon {
    display: flex;
    color: var(--accent);
    background: rgb(var(--accent-rgb) / 0.1);
    border: 1px solid rgb(var(--accent-rgb) / 0.25);
    padding: 0.5rem;
    border-radius: var(--radius-sm);
  }
  .module-head h3 {
    font-size: 1.2rem;
    font-family: var(--font-sans);
  }
  .module-summary {
    font-size: 0.92rem;
    margin-bottom: 1.25rem;
  }
  .module-items {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: auto;
  }
  .module-items li {
    font-size: 0.85rem;
    color: var(--muted);
    padding: 0.35rem 0;
    border-bottom: 1px dashed var(--border);
  }
  .module-items li:last-child {
    border-bottom: none;
  }

  @media (max-width: 900px) {
    .modules {
      grid-template-columns: 1fr;
    }
    .modules-link {
      display: none;
    }
  }
</style>
