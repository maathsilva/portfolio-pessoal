---
import { skillGroups } from '../data/skills';
import Icon from './Icon.astro';
---

<section id="habilidades" class="section">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Habilidades</span>
      <h2 class="section-title">Habilidades Técnicas</h2>
      <p class="section-lede">
        A mesma stack usada na experiência e nos projetos acima, organizada por categoria.
      </p>
    </div>

    <div class="skills-grid" data-reveal-group>
      {skillGroups.map((group) => (
        <div class="skill-group card card-hover">
          <div class="skill-group-head">
            <Icon name={group.icon} size={22} />
            <h3>{group.title}</h3>
          </div>
          <ul class="skill-items">
            {group.items.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .skill-group {
    padding: 1.5rem;
  }
  .skill-group-head {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--accent);
    margin-bottom: 1rem;
  }
  .skill-group-head h3 {
    font-size: 1rem;
    color: var(--text);
    font-family: var(--font-sans);
    font-weight: 600;
  }
  .skill-items li {
    font-size: 0.88rem;
    color: var(--muted);
    padding: 0.3rem 0;
    border-bottom: 1px dashed var(--border);
  }
  .skill-items li:last-child {
    border-bottom: none;
  }

  @media (max-width: 900px) {
    .skills-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .skills-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
