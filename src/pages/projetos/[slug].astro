---
import { Code } from 'astro:components';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { projects } from '../../data/projects';
import { site } from '../../data/site';
import { getImage } from '../../lib/images';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const cover = getImage(project.cover);
---

<BaseLayout
  title={`${project.title} | ${site.name}`}
  description={project.subtitle}
  path={`/projetos/${project.slug}`}
>
  <article>
    <section class="case-hero">
      <div class="container">
        <p class="breadcrumb mono">
          <a href="/#projetos">Projetos</a> / {project.title}
        </p>
        <h1>{project.title}</h1>
        <p class="case-subtitle">{project.subtitle}</p>
        <div class="case-meta mono">
          <span>{project.context}</span>
          <span>·</span>
          <span>{project.timeframe}</span>
        </div>
        <div class="tags">
          {project.tags.map((tag) => <span class="tag">{tag}</span>)}
        </div>
      </div>
    </section>

    <div class="container cover-wrap">
      <Image src={cover} alt={`Imagem de destaque do projeto ${project.title}`} width={1000} loading="eager" class="cover-image" />
    </div>

    <section class="section case-body">
      <div class="container case-grid">
        <div class="case-main">
          <div>
            <h2>O Problema</h2>
            <p>{project.problem}</p>
          </div>

          <div>
            <h2>A Solução</h2>
            <ul class="detail-list">
              {project.solution.map((item) => <li>{item}</li>)}
            </ul>
          </div>

          <div>
            <h2>Arquitetura</h2>
            <ul class="detail-list">
              {project.architecture.map((item) => <li>{item}</li>)}
            </ul>
          </div>

          {project.gallery.length > 0 && (
            <div>
              <h2>Interface</h2>
              <div class="gallery-grid">
                {project.gallery.map((img) => {
                  const galleryImg = getImage(img.file);
                  return (
                    <figure>
                      <Image src={galleryImg} alt={img.alt} width={480} loading="lazy" />
                      <figcaption>{img.caption}</figcaption>
                    </figure>
                  );
                })}
              </div>
            </div>
          )}

          {project.code && (
            <div>
              <h2>Código em destaque</h2>
              <div class="code-block">
                <div class="code-header mono">
                  <Icon name="file-text" size={16} />
                  <span>{project.code.filename}</span>
                </div>
                <Code code={project.code.snippet} lang={project.code.lang as any} theme="github-dark" />
              </div>
            </div>
          )}

          <div>
            <h2>Aprendizados</h2>
            <p>{project.learnings}</p>
          </div>
        </div>

        <aside class="case-sidebar">
          <div class="card sidebar-card">
            <h3>Resultado</h3>
            <dl class="result-list">
              {project.results.map((result) => (
                <div class="result-item">
                  <dt class="mono">{result.value}</dt>
                  <dd>{result.label}</dd>
                </div>
              ))}
            </dl>
            {project.resultsNote && <p class="result-note">{project.resultsNote}</p>}
          </div>

          <div class="card sidebar-card">
            <h3>Links</h3>
            <a href={site.github} target="_blank" rel="noopener noreferrer" class="btn btn-secondary sidebar-btn">
              <Icon name="github" size={18} /> Ver perfil GitHub
            </a>
            <a href="/#projetos" class="btn btn-secondary sidebar-btn">
              <Icon name="chevron-left" size={18} /> Voltar aos projetos
            </a>
          </div>
        </aside>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .case-hero {
    padding: 3.5rem 0 2.5rem;
    background: var(--bg-elevated);
    border-bottom: 1px solid var(--border);
  }
  .case-hero .container {
    max-width: 860px;
  }
  .breadcrumb {
    font-size: 0.85rem;
    color: var(--muted-2);
    margin-bottom: 1rem;
  }
  .breadcrumb a {
    color: var(--accent);
  }
  .case-hero h1 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    margin-bottom: 0.85rem;
  }
  .case-subtitle {
    font-size: 1.15rem;
    max-width: 65ch;
    margin-bottom: 1.25rem;
  }
  .case-meta {
    display: flex;
    gap: 0.6rem;
    color: var(--muted-2);
    font-size: 0.85rem;
    margin-bottom: 1.25rem;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .cover-wrap {
    max-width: 1000px;
    margin-top: -1.5rem;
    position: relative;
    z-index: 5;
  }
  .cover-wrap :global(.cover-image) {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    border: 1px solid var(--border-strong);
    box-shadow: 0 20px 50px hsl(0 0% 0% / 0.35);
  }

  .case-body {
    padding-top: 3.5rem;
  }
  .case-grid {
    max-width: 1000px;
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 3rem;
    align-items: start;
  }
  .case-main h2 {
    font-size: 1.5rem;
    color: var(--accent);
    margin: 2.5rem 0 1rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--border);
  }
  .case-main > div:first-child h2 {
    margin-top: 0;
  }
  .case-main p {
    font-size: 1.02rem;
    line-height: 1.8;
  }
  .detail-list {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .detail-list li {
    font-size: 1rem;
    color: var(--muted);
    padding-left: 1.3rem;
    position: relative;
    line-height: 1.6;
  }
  .detail-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-dim);
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .gallery-grid figure {
    margin: 0;
  }
  .gallery-grid :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
  }
  .gallery-grid figcaption {
    font-size: 0.85rem;
    color: var(--muted-2);
    margin-top: 0.6rem;
  }

  .code-block {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .code-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--bg-elevated);
    padding: 0.75rem 1.1rem;
    border-bottom: 1px solid var(--border);
    font-size: 0.85rem;
    color: var(--muted);
  }
  .code-block :global(pre) {
    margin: 0 !important;
    border-radius: 0 !important;
    font-size: 0.85rem !important;
    padding: 1.25rem !important;
  }

  .case-sidebar {
    position: sticky;
    top: 6.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .sidebar-card {
    padding: 1.5rem;
  }
  .sidebar-card h3 {
    font-size: 1rem;
    font-family: var(--font-sans);
    margin-bottom: 1.1rem;
  }
  .result-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .result-item dt {
    font-size: 1.3rem;
    color: var(--accent);
  }
  .result-item dd {
    font-size: 0.82rem;
    color: var(--muted-2);
    margin-top: 0.25rem;
  }
  .result-note {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px dashed var(--border);
    font-size: 0.78rem;
    color: var(--muted-2);
  }
  .sidebar-btn {
    width: 100%;
    margin-top: 0.75rem;
  }
  .sidebar-btn:first-of-type {
    margin-top: 0;
  }

  @media (max-width: 860px) {
    .case-grid {
      grid-template-columns: 1fr;
    }
    .case-sidebar {
      position: static;
    }
    .gallery-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
