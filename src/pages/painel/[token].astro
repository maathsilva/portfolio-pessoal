---
import '../../styles/global.css';
import '../../styles/panel.css';
import LineChart from '../../components/panel/LineChart.astro';
import ColumnChart from '../../components/panel/ColumnChart.astro';
import Ranking from '../../components/panel/Ranking.astro';
import { getDashboardData, parsePeriod, PERIODS, type DashboardData } from '../../lib/analytics-queries';
import { IGNORE_COOKIE, getClientIp, hashIp } from '../../lib/analytics-server';
import {
  LOCKOUT_MESSAGE,
  PANEL_COOKIE,
  hasValidSession,
  isValidPassword,
  isValidToken,
  loginLockedOut,
  recordFailedLogin,
  sessionCookieValue,
} from '../../lib/panel-auth';
import {
  CTA_NAMES,
  DEVICE_NAMES,
  countryName,
  duration,
  fmt,
  formatTime,
  languageName,
  originName,
  projectName,
  rate,
  timeAgo,
} from '../../lib/panel-format';
import { site } from '../../data/site';

export const prerender = false;

const { token } = Astro.params;
if (!isValidToken(token)) {
  return new Response('Not found', { status: 404 });
}

Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
Astro.response.headers.set('Cache-Control', 'no-store');

const base = Astro.url.pathname;

if (Astro.url.searchParams.has('sair')) {
  Astro.cookies.delete(PANEL_COOKIE, { path: '/painel' });
  return Astro.redirect(base, 303);
}

const cookieBase = { httpOnly: true, secure: import.meta.env.PROD, sameSite: 'lax' as const };
const setIgnoreCookie = () => Astro.cookies.set(IGNORE_COOKIE, '1', { ...cookieBase, path: '/', maxAge: 60 * 60 * 24 * 365 });

let authed = hasValidSession(Astro.cookies.get(PANEL_COOKIE)?.value);
let wrongPassword = false;
let lockedOut = false;
let unavailable = false;

if (!authed && Astro.request.method === 'POST') {
  try {
    const ipHash = hashIp(getClientIp(Astro.request));
    if (await loginLockedOut(ipHash)) {
      lockedOut = true;
      Astro.response.status = 429;
    } else {
      const form = await Astro.request.formData().catch(() => null);
      if (form && isValidPassword(String(form.get('password') ?? ''))) {
        Astro.cookies.set(PANEL_COOKIE, sessionCookieValue(), { ...cookieBase, path: '/painel', maxAge: 60 * 60 * 12 });
        setIgnoreCookie();
        return Astro.redirect(base, 303);
      }
      await recordFailedLogin(ipHash);
      wrongPassword = true;
    }
  } catch {
    // Fail closed: if the attempt counter is unreachable, nobody gets in.
    unavailable = true;
    Astro.response.status = 503;
  }
}

if (authed && Astro.url.searchParams.has('ignorar')) {
  if (Astro.url.searchParams.get('ignorar') === '0') Astro.cookies.delete(IGNORE_COOKIE, { path: '/' });
  else setIgnoreCookie();
  return Astro.redirect(base, 303);
}
const ignoring = Astro.cookies.has(IGNORE_COOKIE);

const period = parsePeriod(Astro.url.searchParams.get('p'));
const showBots = Astro.url.searchParams.get('robos') === '1';
const botQuery = showBots ? '&robos=1' : '';
const periodLabel = PERIODS.find((p) => p.value === period)!.label.toLowerCase();

let data: DashboardData | null = null;
let loadError: string | null = null;
if (authed) {
  try {
    data = await getDashboardData(period, !showBots);
  } catch (e) {
    loadError = e instanceof Error ? e.message : 'Erro desconhecido';
  }
}

const o = data?.overview ?? null;

const perSession = o?.pages_per_session ?? null;
const tiles = o
  ? [
      { label: 'Pageviews', value: fmt(o.pageviews), hint: perSession ? `${String(perSession).replace('.', ',')} ${perSession <= 1 ? 'página' : 'páginas'} por sessão` : undefined },
      { label: 'Visitantes novos', value: fmt(o.new_visitors), hint: 'primeira visita no período' },
      { label: 'Visitantes recorrentes', value: fmt(o.returning_visitors), hint: 'já tinham visitado antes' },
      { label: 'Contatos diretos', value: fmt(o.contact_clicks), hint: 'currículo, WhatsApp e e-mail' },
      { label: 'Tempo médio na página', value: duration(o.avg_seconds), hint: 'tempo ativo, com a aba visível' },
      { label: 'Leram até o fim', value: o.deep_scroll_pct === null ? '—' : `${o.deep_scroll_pct}%`, hint: 'rolaram ao menos 75% da página' },
    ]
  : [];

const visitorRows = (dim: keyof DashboardData['tops'], map: (l: string) => string = (l) => l) =>
  (data?.tops[dim] ?? []).map((r) => ({ label: map(r.label), value: r.visitors, hint: `${fmt(r.hits)} acessos` }));

const hourItems = Array.from({ length: 24 }, (_, h) => {
  const label = `${String(h).padStart(2, '0')}h`;
  return { label, value: data?.tops.local_hour.find((r) => r.label === label)?.hits ?? 0 };
});

const sectionVisitors = data?.sectionVisitors ?? 0;
const clickRate = (visitors: number) => (sectionVisitors > 0 ? `${Math.min(100, Math.round((visitors / sectionVisitors) * 100))}%` : '—');

const vitals = data?.vitals;
const vitalRows = vitals
  ? [
      { name: 'LCP (carregamento)', value: vitals.lcp_p75 === null ? '—' : `${(vitals.lcp_p75 / 1000).toFixed(1).replace('.', ',')} s`, rating: rate(vitals.lcp_p75, 2500, 4000) },
      { name: 'CLS (estabilidade visual)', value: vitals.cls_p75 === null ? '—' : vitals.cls_p75.toFixed(2).replace('.', ','), rating: rate(vitals.cls_p75, 0.1, 0.25) },
      { name: 'INP (resposta a cliques)', value: vitals.inp_p75 === null ? '—' : `${Math.round(vitals.inp_p75)} ms`, rating: rate(vitals.inp_p75, 200, 500) },
    ]
  : [];

const exportUrl = (tipo: string) => `${base}/export?tipo=${tipo}&p=${period}`;
const botToggleHref = `${base}?p=${period}${showBots ? '' : '&robos=1'}`;
---

<!doctype html>
<html lang="pt-br">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Painel</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <main class="painel">
      {!authed && (
        <form method="post" class="painel-gate card">
          <label for="password">Senha</label>
          <input id="password" name="password" type="password" autocomplete="current-password" autofocus required disabled={lockedOut} />
          {wrongPassword && <p class="painel-error" role="alert">Senha incorreta.</p>}
          {lockedOut && <p class="painel-error" role="alert">{LOCKOUT_MESSAGE}</p>}
          {unavailable && <p class="painel-error" role="alert">Serviço indisponível no momento. Tente novamente em instantes.</p>}
          <button type="submit" class="btn btn-primary" disabled={lockedOut}>Entrar</button>
        </form>
      )}

      {authed && loadError && <p class="painel-error" role="alert">Não foi possível carregar os dados: {loadError}</p>}

      {authed && data && (
        <>
          <header class="painel-head">
            <h1>Painel</h1>
            <p class="painel-meta">
              Atualizado em {formatTime(new Date())} · último acesso registrado: {timeAgo(o?.last_view_at ?? null)} ·
              <a href={`${base}?p=${period}${botQuery}`}>recarregar</a> · <a href={`${base}?sair`}>sair</a>
            </p>
          </header>

          <div class="filters">
            <nav class="filter-group" aria-label="Período">
              {PERIODS.map((p) => (
                <a href={`${base}?p=${p.value}${botQuery}`} aria-current={p.value === period ? 'true' : undefined}>{p.label}</a>
              ))}
            </nav>
            <p class="painel-meta">
              Suas visitas neste navegador: <strong>{ignoring ? 'ignoradas' : 'sendo contadas'}</strong> ·
              <a href={`${base}?ignorar=${ignoring ? '0' : '1'}`}>{ignoring ? 'voltar a contar' : 'ignorar'}</a>
            </p>
            <p class="painel-meta">
              Prováveis robôs em {periodLabel}: <strong>{fmt(data.botCount)}</strong>
              {showBots ? 'mostrados (marcados)' : 'ocultos das contagens'} ·
              <a href={botToggleHref}>{showBots ? 'ocultar' : 'mostrar'}</a>
            </p>
            <p class="export-links">
              Exportar CSV: <a href={exportUrl('visitas')}>visitas</a> · <a href={exportUrl('eventos')}>eventos</a>
            </p>
          </div>

          {data.databaseDown && (
            <div class="painel-banner" role="alert">
              <strong>Não foi possível falar com o banco de dados.</strong> Se o site ficou uma semana sem visitas, o Supabase pode ter
              pausado o projeto gratuito: abra o painel do Supabase e clique em <em>Restore</em>.
            </div>
          )}
          {!data.databaseDown && data.errors.length > 0 && (
            <div class="painel-banner" role="alert">
              <strong>Algumas seções não carregaram:</strong> {data.errors.join(' · ')}
            </div>
          )}

          {o && o.pageviews === 0 && (
            <p class="painel-note">Nenhuma visita registrada em {periodLabel}. Os números aparecem assim que o site receber acessos.</p>
          )}

          {o && (
            <section class="painel-tiles" aria-label="Resumo">
              <div class="tile hero card">
                <p class="tile-label">Visitantes únicos ({periodLabel})</p>
                <p class="tile-value hero-figure">{fmt(o.unique_visitors)}</p>
                <p class="tile-hint">sem contar IPs repetidos · {fmt(o.unique_all_time)} no histórico completo</p>
              </div>
              {tiles.map((t) => (
                <div class="tile card">
                  <p class="tile-label">{t.label}</p>
                  <p class="tile-value">{t.value}</p>
                  {t.hint && <p class="tile-hint">{t.hint}</p>}
                </div>
              ))}
            </section>
          )}

          {data.series.length > 0 && (
            <section class="card panel-section" aria-labelledby="chart-title">
              <div class="chart-head">
                <h2 id="chart-title">Visitas — {periodLabel}</h2>
                <ul class="legend" aria-label="Legenda">
                  <li><span class="key key-p"></span>Pageviews</li>
                  <li><span class="key key-u"></span>Visitantes únicos</li>
                </ul>
              </div>
              <LineChart
                labels={data.series.map((s) => s.bucket)}
                pageviews={data.series.map((s) => s.pageviews)}
                uniques={data.series.map((s) => s.unique_visitors)}
              />
            </section>
          )}

          <section class="card panel-section" aria-labelledby="proj-title">
            <h2 id="proj-title">Projetos: qual case atrai mais</h2>
            <p class="section-sub">
              Taxa de clique = visitantes que abriram o card ÷ visitantes que viram a seção de projetos ({fmt(sectionVisitors)} em {periodLabel}).
            </p>
            {data.projects.length === 0 ? (
              <p class="empty">Sem cliques em projetos em {periodLabel}.</p>
            ) : (
              <div class="feed-scroll">
                <table>
                  <thead>
                    <tr><th>Projeto</th><th>Cliques no card</th><th>Taxa de clique</th><th>Acessos à página</th><th>Tempo médio na página</th></tr>
                  </thead>
                  <tbody>
                    {data.projects.map((p) => (
                      <tr>
                        <td>{projectName(p.slug)}</td>
                        <td>{fmt(p.clicks)}</td>
                        <td>{clickRate(p.click_visitors)}</td>
                        <td>{fmt(p.page_views)}</td>
                        <td>{duration(p.avg_seconds)}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          </section>

          <section class="painel-rankings" aria-label="Rankings">
            <Ranking title="Páginas mais vistas" unit="acessos" rows={data.tops.path.map((r) => ({ label: r.label, value: r.hits, hint: `${fmt(r.visitors)} visitantes` }))} />
            <Ranking title="Origem do tráfego" unit="visitantes" rows={visitorRows('referrer', originName)} />
            <Ranking title="Cliques em contatos e perfis" unit="cliques" rows={data.contacts.map((r) => ({ label: CTA_NAMES[r.label] ?? r.label, value: r.hits }))} />
            <Ranking title="Cidades" unit="visitantes" rows={visitorRows('city')} />
            <Ranking title="Países" unit="visitantes" rows={visitorRows('country', countryName)} />
            <Ranking title="Dispositivos" unit="visitantes" rows={visitorRows('device', (l) => DEVICE_NAMES[l] ?? l)} />
            <Ranking title="Navegadores" unit="visitantes" rows={visitorRows('browser')} />
            <Ranking title="Sistemas operacionais" unit="visitantes" rows={visitorRows('os')} />
            <Ranking title="Idiomas" unit="visitantes" rows={visitorRows('language', languageName)} />
          </section>

          <section class="card panel-section" aria-labelledby="hour-title">
            <h2 id="hour-title">Horário local do visitante</h2>
            <p class="section-sub">Acessos por hora do dia no fuso de quem visitou: picos em horário comercial sugerem recrutadores.</p>
            <ColumnChart items={hourItems} unit="acessos" ariaLabel="Acessos por hora do dia" />
          </section>

          <section class="card panel-section" aria-labelledby="eng-title">
            <h2 id="eng-title">Engajamento e desempenho</h2>
            {data.engagement.length === 0 ? (
              <p class="empty">Sem dados de engajamento em {periodLabel}.</p>
            ) : (
              <div class="feed-scroll">
                <table>
                  <thead>
                    <tr><th>Página</th><th>Acessos</th><th>Tempo médio</th><th>Rolagem média</th><th>Chegaram a 75%</th></tr>
                  </thead>
                  <tbody>
                    {data.engagement.map((e) => (
                      <tr>
                        <td>{e.path}</td>
                        <td>{fmt(e.views)}</td>
                        <td>{duration(e.avg_seconds)}</td>
                        <td>{e.avg_scroll === null ? '—' : `${e.avg_scroll}%`}</td>
                        <td>{e.deep_pct === null ? '—' : `${e.deep_pct}%`}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
            <h2 style="margin-top:1.25rem">Web Vitals reais (percentil 75, {fmt(vitals?.samples ?? 0)} medições)</h2>
            <div class="feed-scroll">
              <table>
                <thead><tr><th>Métrica</th><th>Valor</th><th>Avaliação</th></tr></thead>
                <tbody>
                  {vitalRows.map((v) => (
                    <tr><td>{v.name}</td><td>{v.value}</td><td class="vital-rating">{v.rating ?? '—'}</td></tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>

          <section class="card panel-section" aria-labelledby="feed-title">
            <h2 id="feed-title">Últimos acessos</h2>
            <div class="feed-scroll">
              <table>
                <thead>
                  <tr><th>Quando</th><th>Página</th><th>Origem</th><th>Local</th><th>Dispositivo</th>{showBots && <th>Marcação</th>}</tr>
                </thead>
                <tbody>
                  {data.recent.map((v) => {
                    const host = v.referrer?.match(/^https?:\/\/(?:www\.)?([^/?#]+)/)?.[1];
                    const own = host?.includes('matheussilvabaptista');
                    const place = [v.city, v.region, v.country && countryName(v.country)].filter(Boolean).join(', ');
                    return (
                      <tr class={v.probable_bot ? 'is-bot' : undefined}>
                        <td>{formatTime(v.created_at)}</td>
                        <td>{v.path}</td>
                        <td>{own ? 'interno' : (host ?? 'Direto')}</td>
                        <td>{place || '—'}</td>
                        <td>{[DEVICE_NAMES[v.device ?? ''], v.browser].filter(Boolean).join(' · ') || '—'}</td>
                        {showBots && <td class={v.probable_bot ? 'bot-flag' : undefined}>{v.probable_bot ? `Provável robô: ${v.bot_reasons}` : '—'}</td>}
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </section>
        </>
      )}
    </main>
  </body>
</html>
