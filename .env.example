# Supabase (server-only — never exposed to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Only needed locally to run `npm run db:migrate` — never used at runtime
DATABASE_URL=

# Secret salt used to hash visitor IPs before storing them (never store raw IPs)
IP_HASH_SALT=

# Painel privado
DASHBOARD_TOKEN=
DASHBOARD_PASSWORD=
